<section class="tab standard-form {{#if tab.active}}active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{formGroup fields.img value=source.img rootId=rootId}}
  <div class="form-group">
    <label>{{localize "CARDS.Dimensions"}}</label>
    <div class="form-fields">
      {{formInput fields.width value=source.width placeholder=(localize fields.width.label) aria=(object label=fields.width.label)}}
      {{formInput fields.height value=source.height placeholder=(localize fields.height.label) aria=(object label=fields.height.label)}}
      {{formInput fields.rotation value=source.rotation placeholder=(localize fields.rotation.label) aria=(object label=fields.rotation.label)}}
    </div>
  </div>
  <div class="form-group">
    <label for="{{rootId}}-owner">{{localize "ADVANCED_INTERFACE.PlayingCards.PrimaryOwner"}}</label>
    <div class="form-fields">
      <select id="{{rootId}}-owner" name="flags.advanced-interface.primaryOwner">
        <option value="">{{localize "ADVANCED_INTERFACE.PlayingCards.None"}}</option>
        {{#each owners}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
      </select>
    </div>
  </div>
  {{formGroup fields.description value=source.description enriched=descriptionHTML button=true toggled=false height=300 rootId=rootId}}
</section>